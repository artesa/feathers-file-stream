{
  "name": "@artesa/feathers-file-stream",
  "version": "0.8.0",
  "description": "feathers.js plugin for file uploads and downloads with streams",
  "author": "Artesa",
  "homepage": "https://github.com/Artesa/feathers-file-stream",
  "repository": {
    "type": "git",
    "url": "https://github.com/Artesa/feathers-file-stream"
  },
  "keywords": [
    "feathersjs",
    "feathers-plugin",
    "upload",
    "file",
    "stream",
    "s3"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "engines": {
    "node": ">= 22.0.0"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "src/**",
    "dist/**",
    "tsconfig.json"
  ],
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "build": "pnpm run typecheck && tsdown",
    "typecheck": "tsc --noEmit",
    "version": "pnpm run build",
    "release": "np",
    "test": "vitest run",
    "test:integration": "vitest run test/s3-minio.test.ts",
    "vitest": "vitest",
    "lint": "eslint"
  },
  "dependencies": {
    "feathers-utils": "^10.0.2",
    "mime-types": "^3.0.2"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3",
    "@aws-sdk/lib-storage": "^3",
    "@feathersjs/errors": "^5",
    "@feathersjs/feathers": "^5",
    "express": "^4 || ^5",
    "multer": "^2"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@aws-sdk/lib-storage": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "multer": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1063.0",
    "@aws-sdk/lib-storage": "^3.1063.0",
    "@feathers-community/eslint-config": "^0.1.0",
    "@feathersjs/client": "^5.0.45",
    "@feathersjs/errors": "^5.0.45",
    "@feathersjs/express": "^5.0.45",
    "@feathersjs/feathers": "^5.0.45",
    "@feathersjs/rest-client": "^5.0.45",
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/mime-types": "^3.0.1",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.2",
    "@types/supertest": "^7.2.0",
    "aws-sdk-client-mock": "^4.1.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "eslint": "^10.4.1",
    "express": "^4.19.2",
    "get-port": "^7.2.0",
    "helmet": "^8.2.0",
    "multer": "^2.1.1",
    "node-fetch": "^3.3.2",
    "np": "^11.2.1",
    "prettier": "^3.8.3",
    "supertest": "^7.2.2",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3",
    "unrun": "^0.3.1",
    "vitest": "^4.1.8"
  }
}
