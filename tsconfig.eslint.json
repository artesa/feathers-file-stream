{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["vitest/globals"]
  },
  "include": [
    "src/**/*",
    "test/**/*",
    "eslint.config.mjs",
    "tsdown.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules"]
}
